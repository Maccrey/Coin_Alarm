import 'dart:convert';
import 'package:http/http.dart' as http;

class UpbitApiService {
  static const String _baseUrl = 'https://api.upbit.com/v1';
  
  Future<double?> getCurrentPrice(String market) async {
    try {
      final response = await http.get(
        Uri.parse('$_baseUrl/ticker?markets=$market'),
        headers: {'Accept': 'application/json'},
      );

      if (response.statusCode == 200) {
        final List<dynamic> data = jsonDecode(response.body);
        if (data.isNotEmpty) {
          return data[0]['trade_price'].toDouble();
        }
      }
      return null;
    } catch (e) {
      print('API 호출 에러: $e');
      return null;
    }
  }

  Future<Map<String, double>> getMultiplePrices(List<String> markets) async {
    final Map<String, double> prices = {};
    
    try {
      final marketString = markets.join(',');
      final response = await http.get(
        Uri.parse('$_baseUrl/ticker?markets=$marketString'),
        headers: {'Accept': 'application/json'},
      );

      if (response.statusCode == 200) {
        final List<dynamic> data = jsonDecode(response.body);
        for (var item in data) {
          prices[item['market']] = item['trade_price'].toDouble();
        }
      }
    } catch (e) {
      print('다중 가격 조회 에러: $e');
    }
    
    return prices;
  }
}
