import 'dart:convert';
import 'package:shared_preferences/shared_preferences.dart';
import '../models/alarm_setting.dart';

class AlarmRepository {
  static const String _alarmsKey = 'alarm_settings';
  
  Future<List<AlarmSetting>> getAlarms() async {
    final prefs = await SharedPreferences.getInstance();
    final alarmsJson = prefs.getStringList(_alarmsKey) ?? [];
    
    return alarmsJson
        .map((json) => AlarmSetting.fromJson(jsonDecode(json)))
        .toList();
  }

  Future<void> saveAlarm(AlarmSetting alarm) async {
    final alarms = await getAlarms();
    alarms.add(alarm);
    await _saveAlarms(alarms);
  }

  Future<void> updateAlarm(AlarmSetting alarm) async {
    final alarms = await getAlarms();
    final index = alarms.indexWhere((a) => a.id == alarm.id);
    if (index != -1) {
      alarms[index] = alarm;
      await _saveAlarms(alarms);
    }
  }

  Future<void> deleteAlarm(String id) async {
    final alarms = await getAlarms();
    alarms.removeWhere((alarm) => alarm.id == id);
    await _saveAlarms(alarms);
  }

  Future<void> _saveAlarms(List<AlarmSetting> alarms) async {
    final prefs = await SharedPreferences.getInstance();
    final alarmsJson = alarms
        .map((alarm) => jsonEncode(alarm.toJson()))
        .toList();
    await prefs.setStringList(_alarmsKey, alarmsJson);
  }
}
