class AlarmSetting {
  final String id;
  final String coinSymbol;
  final String coinName;
  final double targetPrice;
  final AlarmType alarmType; // above, below
  final bool isEnabled;
  final DateTime createdAt;

  AlarmSetting({
    required this.id,
    required this.coinSymbol,
    required this.coinName,
    required this.targetPrice,
    required this.alarmType,
    this.isEnabled = true,
    required this.createdAt,
  });

  Map<String, dynamic> toJson() => {
    'id': id,
    'coinSymbol': coinSymbol,
    'coinName': coinName,
    'targetPrice': targetPrice,
    'alarmType': alarmType.toString(),
    'isEnabled': isEnabled,
    'createdAt': createdAt.toIso8601String(),
  };

  factory AlarmSetting.fromJson(Map<String, dynamic> json) => AlarmSetting(
    id: json['id'],
    coinSymbol: json['coinSymbol'],
    coinName: json['coinName'],
    targetPrice: json['targetPrice'].toDouble(),
    alarmType: AlarmType.values.firstWhere(
      (e) => e.toString() == json['alarmType']
    ),
    isEnabled: json['isEnabled'],
    createdAt: DateTime.parse(json['createdAt']),
  );
}

