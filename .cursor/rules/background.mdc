import '../models/alarm_setting.dart';
import '../repositories/alarm_repository.dart';
import 'upbit_api_service.dart';
import 'notification_service.dart';

class PriceMonitorService {
  final AlarmRepository _alarmRepository = AlarmRepository();
  final UpbitApiService _apiService = UpbitApiService();
  final NotificationService _notificationService = NotificationService();

  Future<void> checkPriceAlerts() async {
    try {
      final alarms = await _alarmRepository.getAlarms();
      final enabledAlarms = alarms.where((alarm) => alarm.isEnabled).toList();
      
      if (enabledAlarms.isEmpty) return;

      final markets = enabledAlarms
          .map((alarm) => 'KRW-${alarm.coinSymbol}')
          .toSet()
          .toList();

      final currentPrices = await _apiService.getMultiplePrices(markets);

      for (final alarm in enabledAlarms) {
        final market = 'KRW-${alarm.coinSymbol}';
        final currentPrice = currentPrices[market];
        
        if (currentPrice != null && _shouldTriggerAlarm(alarm, currentPrice)) {
          await _triggerAlarm(alarm, currentPrice);
        }
      }
    } catch (e) {
      print('가격 모니터링 에러: $e');
    }
  }

  bool _shouldTriggerAlarm(AlarmSetting alarm, double currentPrice) {
    switch (alarm.alarmType) {
      case AlarmType.above:
        return currentPrice >= alarm.targetPrice;
      case AlarmType.below:
        return currentPrice <= alarm.targetPrice;
    }
  }

  Future<void> _triggerAlarm(AlarmSetting alarm, double currentPrice) async {
    await _notificationService.showPriceAlert(
      coinSymbol: alarm.coinSymbol,
      currentPrice: currentPrice,
      targetPrice: alarm.targetPrice,
      alarmType: alarm.alarmType.toString(),
    );

    // 알림 후 해당 알람 비활성화 (중복 알림 방지)
    final updatedAlarm = AlarmSetting(
      id: alarm.id,
      coinSymbol: alarm.coinSymbol,
      coinName: alarm.coinName,
      targetPrice: alarm.targetPrice,
      alarmType: alarm.alarmType,
      isEnabled: false,
      createdAt: alarm.createdAt,
    );
    
    await _alarmRepository.updateAlarm(updatedAlarm);
  }
}
