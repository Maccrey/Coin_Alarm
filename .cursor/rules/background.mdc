import 'package:flutter/material.dart';
import '../services/coin_alarm_service.dart';
import '../models/alarm_setting.dart';
import '../repositories/alarm_repository.dart';

class AlarmSettingScreen extends StatefulWidget {
  @override
  _AlarmSettingScreenState createState() => _AlarmSettingScreenState();
}

class _AlarmSettingScreenState extends State<AlarmSettingScreen> {
  final _formKey = GlobalKey<FormState>();
  final _priceController = TextEditingController();
  final AlarmRepository _repository = AlarmRepository();
  
  String _selectedCoin = 'BTC';
  AlarmType _alarmType = AlarmType.above;
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('알림 설정')),
      body: Form(
        key: _formKey,
        child: Padding(
          padding: EdgeInsets.all(16.0),
          child: Column(
            children: [
              _buildCoinSelector(),
              _buildPriceInput(),
              _buildAlarmTypeSelector(),
              _buildSaveButton(),
              _buildAlarmList(),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildCoinSelector() {
    return DropdownButtonFormField<String>(
      value: _selectedCoin,
      decoration: InputDecoration(labelText: '코인 선택'),
      items: ['BTC', 'ETH', 'XRP', 'ADA', 'DOT']
          .map((coin) => DropdownMenuItem(
                value: coin,
                child: Text(coin),
              ))
          .toList(),
      onChanged: (value) => setState(() => _selectedCoin = value!),
    );
  }

  Widget _buildPriceInput() {
    return TextFormField(
      controller: _priceController,
      decoration: InputDecoration(
        labelText: '목표 가격 (원)',
        suffixText: '원',
      ),
      keyboardType: TextInputType.number,
      validator: (value) {
        if (value == null || value.isEmpty) {
          return '가격을 입력해주세요';
        }
        if (double.tryParse(value) == null) {
          return '올바른 숫자를 입력해주세요';
        }
        return null;
      },
    );
  }

  Widget _buildAlarmTypeSelector() {
    return Column(
      children: [
        RadioListTile<AlarmType>(
          title: Text('가격이 이상일 때'),
          value: AlarmType.above,
          groupValue: _alarmType,
          onChanged: (value) => setState(() => _alarmType = value!),
        ),
        RadioListTile<AlarmType>(
          title: Text('가격이 이하일 때'),
          value: AlarmType.below,
          groupValue: _alarmType,
          onChanged: (value) => setState(() => _alarmType = value!),
        ),
      ],
    );
  }

  Widget _buildSaveButton() {
    return ElevatedButton(
      onPressed: _saveAlarm,
      child: Text('알림 설정'),
      style: ElevatedButton.styleFrom(
        minimumSize: Size(double.infinity, 50),
      ),
    );
  }

  Widget _buildAlarmList() {
    return Expanded(
      child: FutureBuilder<List<AlarmSetting>>(
        future: _repository.getAlarms(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) {
            return Center(child: CircularProgressIndicator());
          }
          
          final alarms = snapshot.data!;
          return ListView.builder(
            itemCount: alarms.length,
            itemBuilder: (context, index) {
              final alarm = alarms[index];
              return _buildAlarmTile(alarm);
            },
          );
        },
      ),
    );
  }

  Widget _buildAlarmTile(AlarmSetting alarm) {
    return Card(
      child: ListTile(
        leading: CircleAvatar(child: Text(alarm.coinSymbol)),
        title: Text('${alarm.coinName} (${alarm.coinSymbol})'),
        subtitle: Text(
          '${alarm.alarmType == AlarmType.above ? "이상" : "이하"}: '
          '${alarm.targetPrice.toStringAsFixed(0)}원'
        ),
        trailing: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Switch(
              value: alarm.isEnabled,
              onChanged: (enabled) => _toggleAlarm(alarm, enabled),
            ),
            IconButton(
              icon: Icon(Icons.delete),
              onPressed: () => _deleteAlarm(alarm.id),
            ),
          ],
        ),
      ),
    );
  }

  Future<void> _saveAlarm() async {
    if (!_formKey.currentState!.validate()) return;

    final alarm = AlarmSetting(
      id: DateTime.now().millisecondsSinceEpoch.toString(),
      coinSymbol: _selectedCoin,
      coinName: _getCoinName(_selectedCoin),
      targetPrice: double.parse(_priceController.text),
      alarmType: _alarmType,
      createdAt: DateTime.now(),
    );

    await _repository.saveAlarm(alarm);
    _priceController.clear();
    setState(() {});
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('알림이 설정되었습니다')),
    );
  }

  String _getCoinName(String symbol) {
    final coinNames = {
      'BTC': 'Bitcoin',
      'ETH': 'Ethereum',
      'XRP': 'Ripple',
      'ADA': 'Cardano',
      'DOT': 'Polkadot',
    };
    return coinNames[symbol] ?? symbol;
  }

  Future<void> _toggleAlarm(AlarmSetting alarm, bool enabled) async {
    final updatedAlarm = AlarmSetting(
      id: alarm.id,
      coinSymbol: alarm.coinSymbol,
      coinName: alarm.coinName,
      targetPrice: alarm.targetPrice,
      alarmType: alarm.alarmType,
      isEnabled: enabled,
      createdAt: alarm.createdAt,
    );
    
    await _repository.updateAlarm(updatedAlarm);
    setState(() {});
  }

  Future<void> _deleteAlarm(String id) async {
    await _repository.deleteAlarm(id);
    setState(() {});
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('알림이 삭제되었습니다')),
    );
  }
}
