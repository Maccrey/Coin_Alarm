import 'dart:io';

class ErrorHandler {
  static void handleApiError(dynamic error) {
    if (error is SocketException) {
      print('네트워크 연결 에러: ${error.message}');
    } else if (error is HttpException) {
      print('HTTP 에러: ${error.message}');
    } else {
      print('알 수 없는 API 에러: $error');
    }
  }

  static void handleBackgroundError(dynamic error) {
    print('백그라운드 처리 에러: $error');
    // 로그 저장 또는 에러 리포팅
  }

  static void handleNotificationError(dynamic error) {
    print('알림 에러: $error');
    // 알림 권한 재요청 등 복구 로직
  }
}
