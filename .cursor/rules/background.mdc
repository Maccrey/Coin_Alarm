import 'dart:io';
import 'ios_background_service.dart';
import 'android_foreground_service.dart';

class BackgroundManager {
  static Future<void> initialize() async {
    if (Platform.isIOS) {
      await IosBackgroundService.initialize();
    } else if (Platform.isAndroid) {
      await AndroidForegroundService.initialize();
    }
  }

  static Future<void> startBackgroundMonitoring() async {
    if (Platform.isIOS) {
      await IosBackgroundService.startMonitoring();
    } else if (Platform.isAndroid) {
      await AndroidForegroundService.startService();
    }
  }

  static Future<void> stopBackgroundMonitoring() async {
    if (Platform.isIOS) {
      await IosBackgroundService.stopMonitoring();
    } else if (Platform.isAndroid) {
      await AndroidForegroundService.stopService();
    }
  }

  static String getBackgroundType() {
    if (Platform.isIOS) {
      return 'iOS Background App Refresh';
    } else if (Platform.isAndroid) {
      return 'Android Foreground Service';
    }
    return 'Unknown Platform';
  }
}
