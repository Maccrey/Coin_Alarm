  factory CoinAlarmService() => _instance;
  CoinAlarmService._internal();

  final AppLifecycleService _lifecycleService = AppLifecycleService();
  final AlarmRepository _alarmRepository = AlarmRepository();
  bool _isInitialized = false;

  Future<void> initialize() async {
    if (_isInitialized) return;

    await NotificationService().initialize();
    await BackgroundManager.initialize();

    _lifecycleService.initialize(
      onBackground: _onAppBackground,
      onForeground: _onAppForeground,
    );

    _isInitialized = true;
  }

  Future<void> _onAppBackground() async {
    print('앱이 백그라운드로 전환됨');
    final hasAlarms = await _hasActiveAlarms();
    
    if (hasAlarms) {
      await BackgroundManager.startBackgroundMonitoring();
      print('백그라운드 모니터링 시작');
    }
  }

  Future<void> _onAppForeground() async {
    print('앱이 포그라운드로 복귀됨');
    await BackgroundManager.stopBackgroundMonitoring();
    print('백그라운드 모니터링 중지');
  }

  Future<bool> _hasActiveAlarms() async {
    final alarms = await _alarmRepository.getAlarms();
    return alarms.any((alarm) => alarm.isEnabled);
  }

  Future<void> dispose() async {
    await BackgroundManager.stopBackgroundMonitoring();
    _lifecycleService.dispose();
  }
}
