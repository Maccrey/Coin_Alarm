import 'dart:io';
import 'package:workmanager/workmanager.dart';
import 'price_monitor_service.dart';

class IosBackgroundService {
  static const String _taskName = 'priceMonitorTask';
  
  static Future<void> initialize() async {
    if (Platform.isIOS) {
      await Workmanager().initialize(
        callbackDispatcher,
        isInDebugMode: false,
      );
    }
  }

  static Future<void> startMonitoring() async {
    if (Platform.isIOS) {
      await Workmanager().registerPeriodicTask(
        _taskName,
        _taskName,
        frequency: const Duration(minutes: 15), // iOS 최소 간격
        constraints: Constraints(
          networkType: NetworkType.connected,
        ),
      );
    }
  }

  static Future<void> stopMonitoring() async {
    if (Platform.isIOS) {
      await Workmanager().cancelByUniqueName(_taskName);
    }
  }
}

@pragma('vm:entry-point')
void callbackDispatcher() {
  Workmanager().executeTask((task, inputData) async {
    try {
      final priceMonitor = PriceMonitorService();
      await priceMonitor.checkPriceAlerts();
      return Future.value(true);
    } catch (e) {
      print('iOS 백그라운드 작업 에러: $e');
      return Future.value(false);
    }
  });
}
